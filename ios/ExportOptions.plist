<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- For TestFlight and the App Store. CI runs `flutter build ipa` with
	     this file, so Xcode never has to be opened. -->
	<key>method</key>
	<string>app-store</string>

	<!-- Must match DEVELOPMENT_TEAM on the Runner target. -->
	<key>teamID</key>
	<string>PTV6284A36</string>

	<!-- CI installs the profile itself, so the export must not look one up.
	     This file governs the export only — the archive signs from the Xcode
	     project, where the Runner target's Release configuration is
	     CODE_SIGN_STYLE = Manual against this same profile. Both have to say
	     manual: with the project on Automatic the archive fails first, with
	     "No Accounts" and "No profiles for 'com.nazorat.aat.uz' were found",
	     before the export is ever reached. The name is the one inside the
	     profile, not its file name. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.nazorat.aat.uz</key>
		<string>Nazorat AAT</string>
	</dict>

	<!-- Uploads dSYMs so Crashlytics can symbolicate iOS crashes. Without
	     them a stack trace is just a list of addresses. -->
	<key>uploadSymbols</key>
	<true/>

	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
